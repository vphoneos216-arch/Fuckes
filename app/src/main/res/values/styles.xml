<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Plain framework theme (no AppCompat/Material dependency added to
         build.gradle on purpose — keeps the build free of a new library
         fetch). Dark, edge-to-edge background matching the UI. -->
    <style name="AppTheme" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/bg_root</item>
        <item name="android:navigationBarColor">@color/bg_root</item>
        <item name="android:colorBackground">@color/bg_root</item>
    </style>
</resources>
