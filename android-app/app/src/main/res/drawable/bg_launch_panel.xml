<?xml version="1.0" encoding="utf-8"?>
<!--
  bg_launch_panel — Money Heist panel.
  Near-pure black surface, deep crimson top stroke.
  Slides up from bottom — the heist begins.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0A0D12" />
    <corners
        android:topLeftRadius="22dp"
        android:topRightRadius="22dp"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
    <stroke android:width="1dp" android:color="@color/stroke_accent" />
</shape>
