<?xml version="1.0" encoding="utf-8"?>
<!--
  InvisibleX App Icon — original monogram mark.
  A hexagonal "security badge" shield holding a bold, geometric IX
  monogram, deep crimson on near-black, with a thin inner ring for a
  layered/engraved feel. Deliberately abstract/geometric (no face,
  mask or character likeness) so the brand mark is wholly original.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ── Deep black background ── -->
    <path
        android:fillColor="#050709"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />

    <!-- ── Radial-feel vignette ring ── -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#2A0B0B"
        android:strokeWidth="2"
        android:pathData="M54,54 m-50,0 a50,50 0 1,0 100,0 a50,50 0 1,0 -100,0" />

    <!-- ── Hexagonal security-badge shield (outer) ── -->
    <path
        android:fillColor="#0D0404"
        android:strokeColor="#7B0000"
        android:strokeWidth="1.4"
        android:pathData="M54,10
                          L90,28
                          L90,66
                          L54,98
                          L18,66
                          L18,28 Z" />

    <!-- ── Inner engraved hex ring — layered depth ── -->
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#C62828"
        android:strokeWidth="1.1"
        android:pathData="M54,18
                          L82,32.5
                          L82,62
                          L54,89
                          L26,62
                          L26,32.5 Z" />

    <!-- ── IX monogram — bold geometric mark, centered ── -->
    <!-- "I" — left stem -->
    <path
        android:fillColor="#F2F5FF"
        android:pathData="M38,37 L46,37 L46,71 L38,71 Z" />

    <!-- "X" — crimson, right of center -->
    <path
        android:fillColor="#E53935"
        android:pathData="M53,37 L62,37 L70,52 L78,37 L87,37 L75,54 L87,71 L78,71
                          L70,56 L62,71 L53,71 L65,54 Z" />

    <!-- ── Thin crimson base accent ── -->
    <path
        android:fillColor="#C62828"
        android:pathData="M0,105 L108,105 L108,108 L0,108 Z" />

</vector>
