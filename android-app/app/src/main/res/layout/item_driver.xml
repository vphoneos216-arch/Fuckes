<?xml version="1.0" encoding="utf-8"?>
<!--
  item_driver.xml — driver-mode row, card style.

  Redesigned (was a flat ListView row with no real selected-state look —
  just a dim/lit 7dp dot and a 0.78 alpha fade, which barely read as
  "selected" vs "not selected" at a glance). Now each row is its own
  rounded card (bg_driver_row_selected / bg_driver_row_idle, toggled in
  DriverAdapter) with breathing room between rows, a left accent stripe
  that only shows when selected, and the raw config-value string (e.g.
  "ditpro") moved into a small monospace pill instead of floating as
  plain gray text — it's an internal token, not something that needs to
  read as a "file size" column.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:background="@drawable/bg_driver_row_idle"
    android:paddingStart="4dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:minHeight="64dp">

    <!-- Left accent stripe — visible only on the selected row -->
    <View
        android:id="@+id/stripe_selected"
        android:layout_width="3dp"
        android:layout_height="34dp"
        android:background="@color/red_primary"
        android:layout_marginEnd="12dp"
        android:visibility="invisible" />

    <!-- Driver info column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1: mode name + selection checkmark dot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_driver_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="driver.ko"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01" />

            <View
                android:id="@+id/dot_selected"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/dot_status_dim"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Kernel hint / how this backend works -->
        <TextView
            android:id="@+id/tv_driver_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="1dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="8dp" />

        <!-- Permission chips + config-value tag, same row -->
        <LinearLayout
            android:id="@+id/row_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chip_read"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="READ"
                android:textSize="9sp"
                android:textColor="@color/chip_read_text"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:background="@drawable/bg_chip_read"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:gravity="center_vertical"
                android:layout_marginEnd="5dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chip_write"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="WRITE"
                android:textSize="9sp"
                android:textColor="@color/chip_write_text"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:background="@drawable/bg_chip_write"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:gravity="center_vertical"
                android:layout_marginEnd="5dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chip_exec"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="EXEC"
                android:textSize="9sp"
                android:textColor="@color/chip_exec_text"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:background="@drawable/bg_chip_exec"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:gravity="center_vertical"
                android:layout_marginEnd="5dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chip_root"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text="ROOT"
                android:textSize="9sp"
                android:textColor="@color/chip_root_text"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:background="@drawable/bg_chip_root"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <!-- config-value tag — e.g. "ditpro", "auto" — small monospace
                 pill instead of plain floating text on the right edge -->
            <TextView
                android:id="@+id/tv_driver_item_size"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:text=""
                android:textSize="9sp"
                android:textColor="@color/text_tertiary"
                android:fontFamily="monospace"
                android:background="@drawable/bg_status_pill"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:gravity="center_vertical" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
