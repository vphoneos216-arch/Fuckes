<?xml version="1.0" encoding="utf-8"?>
<!--
  fragment_driver.xml — Money Heist driver section.
  Kernel driver selection. Dark surface. Crimson authority.
  Every driver loaded goes through security gate — no exceptions.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_black"
    android:padding="20dp">

    <!-- ── Header: section label + title ── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KERNEL MODULE"
        android:textSize="10sp"
        android:textColor="@color/text_label"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.22"
        android:layout_marginBottom="5dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Driver Select"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="-0.01"
        android:layout_marginBottom="6dp" />

    <!-- Accent divider -->
    <View
        android:layout_width="42dp"
        android:layout_height="2dp"
        android:background="@color/red_primary"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/driver_select_hint"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="10dp" />

    <!-- Detected kernel version — decides which bundled module (if any) a
         KPM-style mode will load; shown so the user knows what's being
         matched against. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_status_pill"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:layout_marginBottom="16dp">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/dot_status"
            android:layout_marginEnd="7dp" />

        <TextView
            android:id="@+id/tv_kernel_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kernel: —"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.02" />
    </LinearLayout>

    <!-- ── Driver list card ── -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/stroke_accent"
        app:strokeWidth="1dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVAILABLE DRIVERS"
                android:textSize="10sp"
                android:textColor="@color/text_label"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.20"
                android:layout_marginBottom="12dp" />

            <!-- Empty state -->
            <TextView
                android:id="@+id/tv_no_drivers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/driver_none"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:padding="28dp"
                android:visibility="gone" />

            <!-- Driver list -->
            <ListView
                android:id="@+id/lv_drivers"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@color/divider"
                android:dividerHeight="1dp"
                android:scrollbars="none"
                android:listSelector="@drawable/list_selector" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ── Selected driver info chip ── -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_selected_driver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bg_red_surface"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/stroke_accent"
        app:strokeWidth="1dp"
        android:visibility="gone"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <!-- Left: label + driver name -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECTED"
                    android:textSize="9sp"
                    android:textColor="@color/red_primary"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.18"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:id="@+id/tv_selected_driver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="None"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Right: file size -->
            <TextView
                android:id="@+id/tv_driver_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ── LOAD DRIVER button — primary action ── -->
    <Button
        android:id="@+id/btn_load_driver"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/btn_load_driver"
        android:background="@drawable/bg_button_red"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.10"
        android:textSize="14sp"
        android:enabled="false" />

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/progress_driver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/red_primary"
        android:visibility="gone"
        android:layout_marginTop="8dp" />

    <!-- Operation status feedback -->
    <TextView
        android:id="@+id/tv_driver_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:textColor="@color/status_ok"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:layout_marginTop="10dp" />

</LinearLayout>
