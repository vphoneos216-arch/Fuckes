bool ModernToggle(const char* label, bool* v) {
    ImGuiWindow* w = ImGui::GetCurrentWindow();
    if (w->SkipItems) return false;
    ImGuiContext& g = *GImGui;
    const ImGuiID id = w->GetID(label);
    const ImVec2 ls = ImGui::CalcTextSize(label, NULL, true);
    float h = ImGui::GetFrameHeight() * 0.85f, wd = h * 1.8f;
    const ImVec2 pos = w->DC.CursorPos;
    ImRect bb(pos, ImVec2(pos.x + ImGui::GetWindowWidth() - 30.0f, pos.y + h + g.Style.ItemInnerSpacing.y));
    ImGui::ItemSize(bb, g.Style.FramePadding.y);
    if (!ImGui::ItemAdd(bb, id)) return false;
    auto& st = g_SwitchStates[id];
    auto now = std::chrono::steady_clock::now();
    if (st.lastUpdate.time_since_epoch().count() == 0) { st.knobPosition = *v ? 1.0f : 0.0f; st.targetState = *v; st.lastUpdate = now; }
    bool hovered, held;
    bool pressed = ImGui::ButtonBehavior(bb, id, &hovered, &held);
    if (pressed) { *v = !(*v); st.targetState = *v; st.isAnimating = true; st.lastUpdate = now; ImGui::MarkItemEdited(id); }
    if (st.isAnimating) {
        auto el = std::chrono::duration_cast<std::chrono::milliseconds>(now - st.lastUpdate).count();
        float step = el / 150.0f;
        if (step >= 1.0f) { st.knobPosition = st.targetState ? 1.0f : 0.0f; st.isAnimating = false; }
        else { float tgt = st.targetState ? 1.0f : 0.0f; st.knobPosition += (tgt - st.knobPosition) * step;
            if (st.knobPosition > 1.0f) st.knobPosition = 1.0f; if (st.knobPosition < 0.0f) st.knobPosition = 0.0f; }
    }
    ImDrawList* dl = ImGui::GetWindowDrawList();
    float sx = bb.Max.x - wd - 10.0f;
    ImVec2 mn(sx, pos.y), mx(sx + wd, pos.y + h);
    ImU32 bgc;
    if (st.knobPosition > 0.5f) {
        float t = (st.knobPosition - 0.5f) * 2.0f;
        bgc = ImGui::ColorConvertFloat4ToU32(ImVec4(uiGlowColor.x * t + 0.3f * (1.0f - t), uiGlowColor.y * t + 0.3f * (1.0f - t), uiGlowColor.z * t + 0.35f * (1.0f - t), 1.0f));
    } else bgc = IM_COL32(60, 60, 65, 255);
    float r = h * 0.5f;
    dl->AddRectFilled(mn, mx, bgc, r);
    float ks = h * 0.75f, kp = (h - ks) * 0.5f;
    float kx = mn.x + kp + (mx.x - mn.x - ks - kp * 2) * st.knobPosition;
    dl->AddCircleFilled(ImVec2(kx + ks * 0.5f + 1, mn.y + h * 0.5f + 1), ks * 0.5f, IM_COL32(0, 0, 0, 60));
    dl->AddCircleFilled(ImVec2(kx + ks * 0.5f, mn.y + h * 0.5f), ks * 0.5f, IM_COL32(255, 255, 255, 255));
    if (hovered && uiGlowIntensity > 0.1f) DrawGlow(dl, mn, mx, uiGlowColor, r, uiGlowIntensity * 0.2f, 1);
    ImGui::RenderText(ImVec2(pos.x, pos.y + (h - ls.y) * 0.5f), label);
    return pressed;
}

