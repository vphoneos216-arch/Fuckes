// ==================== MAIN ====================
int main(int argc, char *argv[]) {
    // Increase memory limit
    increase_memory_limit();
    
    // AUTHENTICATION SYSTEM
    Authentication auth;
    
    if (!auth.run()) {
        return 1;
    }
    
    // COPY TO GLOBAL AUTH
    g_auth = auth;
    
    // FORCE STOP GAME BEFORE START
    ForceStopFreeFire();
    
    // INITIALIZE THREADS
    std::thread(VolumeKeyThread).detach();
    std::thread(SilentAimThread).detach();

    while (main_thread_flag && !g_GameInitialized) {
        static int lm = 0;
        auto now = std::chrono::steady_clock::now();
        auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(now.time_since_epoch()).count();
        if (ms - lm > 2000) { 
            printf("%s", oxorany("\n[WAITING] OPEN FF MAX \n")); 
            lm = ms; 
        }

        int pid = getProcessID(packageName);
        if (pid > 0) {
            game_pid = pid; 
            sleep(3);
            lib_base = get_module_base(targetaLibName, PERM_EXEC);
            lib_base2 = get_module_base(targetaLibName2, PERM_EXEC);
            if (lib_base != 0) {
                screen_config();
                ::abs_ScreenX = (displayInfo.height > displayInfo.width ? displayInfo.height : displayInfo.width);
                ::abs_ScreenY = (displayInfo.height < displayInfo.width ? displayInfo.height : displayInfo.width);
                ::native_window_screen_x = ::abs_ScreenX;
                ::native_window_screen_y = ::abs_ScreenX;
                if (!initGUI_draw(native_window_screen_x, native_window_screen_y, true)) { 
                    return -1; 
                }
                Touch_Init(displayInfo.width, displayInfo.height, displayInfo.orientation, true);
                g_GameIsRunning = true; 
                g_GameInitialized = true;
            } else { 
                sleep(2); 
            }
        }
        usleep(100000);
    }

    while (main_thread_flag && g_GameInitialized) {
        int pid = getProcessID(packageName);
        if (pid <= 0) { 
            printf("%s", oxorany("[X] Game closed!\n")); 
            break; 
        }
        bool fg = IsGameInForeground(pid);
        drawBegin();
        {
            ImGui::SetNextWindowPos(ImVec2(-100, -100));
            ImGui::SetNextWindowSize(ImVec2(10, 10));
            ImGui::Begin("##AntiCrash", nullptr, ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoBackground | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoInputs | ImGuiWindowFlags_NoSavedSettings);
            ImGui::End();
            if (fg) {
                RenderMenu();
                if (g_GameIsRunning && lib_base != 0) {
                    DrawESP(abs_ScreenX, abs_ScreenY, lib_base);
                    AimbotMenu(abs_ScreenX, abs_ScreenY, lib_base);
                }
            }
        }
        drawEnd();
        usleep(16000);
    }

    printf("%s", oxorany("Shutting down...\n"));
    shutdown(); 
    Touch_Close();
    return 0;
}