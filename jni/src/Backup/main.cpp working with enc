// ==================== INCREASE MEMORY LIMIT ====================
static void increase_memory_limit() {
    struct rlimit rl;
    
    if (getrlimit(RLIMIT_AS, &rl) == 0) {
        rl.rlim_cur = rl.rlim_max;
        setrlimit(RLIMIT_AS, &rl);
    }
    
    if (getrlimit(RLIMIT_DATA, &rl) == 0) {
        rl.rlim_cur = rl.rlim_max;
        setrlimit(RLIMIT_DATA, &rl);
    }
    
    if (getrlimit(RLIMIT_STACK, &rl) == 0) {
        rl.rlim_cur = rl.rlim_max;
        setrlimit(RLIMIT_STACK, &rl);
    }
    
    nice(-10);
}

// ==================== FORCE STOP FREE FIRE MAX ====================
static bool ForceStopFreeFire() {
    bool stopped = false;
    
    system("am force-stop com.dts.freefiremax 2>/dev/null");
    
    FILE* fp = popen("pidof com.dts.freefiremax 2>/dev/null", "r");
    if (fp) {
        char pid_str[32] = {0};
        if (fgets(pid_str, sizeof(pid_str), fp)) {
            int pid = atoi(pid_str);
            if (pid > 0) {
                char cmd[128];
                snprintf(cmd, sizeof(cmd), "kill -9 %d 2>/dev/null", pid);
                system(cmd);
                stopped = true;
            }
        }
        pclose(fp);
    }
    
    system("pkill -9 com.dts.freefiremax 2>/dev/null");
    sleep(2);
    system("pm clear com.dts.freefiremax 2>/dev/null");
    sleep(1);
    return stopped;
}

